<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/launcher_background"
        android:clipChildren="false"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_list_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.05" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_list_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.95" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_title_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.05" />

        <TextView
            android:id="@+id/tv_all_apps_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_apps_title"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@id/guide_list_start"
            app:layout_constraintTop_toTopOf="@id/guide_title_top" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_installed_apps"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:paddingTop="24dp"
            android:paddingBottom="32dp"
            android:overScrollMode="never"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guide_list_end"
            app:layout_constraintStart_toStartOf="@id/guide_list_start"
            app:layout_constraintTop_toBottomOf="@id/tv_all_apps_title" />

        <TextView
            android:id="@+id/tv_empty_apps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_apps_found"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/rv_installed_apps"
            app:layout_constraintEnd_toEndOf="@id/rv_installed_apps"
            app:layout_constraintStart_toStartOf="@id/rv_installed_apps"
            app:layout_constraintTop_toTopOf="@id/rv_installed_apps" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
